# Copy to .env and fill in. Never commit .env.

# --- Telegram ---
# 1. talk to @BotFather, /newbot, copy token
# 2. /start your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
#    and grab "chat":{"id":...} — that's your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
# Path inside the container (mounted to ./data via docker-compose)
DATABASE_URL=sqlite+aiosqlite:////app/data/tentaclez.db

# --- Runtime ---
LOG_LEVEL=INFO
TZ=America/New_York

# --- SnapTrade (optional, for read-only Robinhood portfolio sync) ---
# Sign up at https://snaptrade.com → developer dashboard → grab clientId + consumerKey.
# Free tier: 5 connected accounts, daily-refreshed data. Leave blank to disable
# the /connect /rh /disconnect commands; the rest of the bot keeps working.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
