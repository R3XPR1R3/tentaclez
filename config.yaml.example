# Copy to config.yaml and tweak.

# --- Active tickers + per-ticker ladder parameters ---
# dip_percent / profit_percent are fractions: 0.02 = 2%.
tickers:
  - symbol: QQQ
    dip_percent: 0.02
    profit_percent: 0.04
  - symbol: XLE
    dip_percent: 0.025
    profit_percent: 0.05

# --- Position sizing as % of free cash ---
sizing:
  min_trade_pct: 0.10   # don't bother trading less than 10% of cash
  max_trade_pct: 0.20   # never more than 20% of cash in a single dip

# --- Profit split when you record a winning /sell ---
# Defaults track the spec: 80% back into the trading pool, 20% into a dividend ETF.
allocation:
  reinvest_trade_pct: 80
  dividend_etf_pct: 20
  dividend_etf_symbols: [SCHD, JEPI]

# --- Schedule (America/New_York; NYSE half-days handled automatically) ---
schedule:
  pre_open_brief: "09:00"
  post_close_summary: "16:30"
  intraday_check_minutes: 10

# --- Optional analytics layer (spec section 7) ---
# Disabled until your capital justifies the extra noise filtering.
analytics:
  enabled: false
  sma_long_period: 200
  vix_pause_threshold: 30
